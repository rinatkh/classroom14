# Справочник; Makefile не загружает файл автоматически. Значения export-ните.
HTTP_ADDR=:8080
TOKEN_TTL=2h
# export JWT_SECRET="$(openssl rand -hex 32)"
JWT_SECRET=
# Примеры отдельных локальных учебных БД; задайте свои user/password/port.
DATABASE_URL=postgres://postgres@localhost:5432/go_course_tasks?sslmode=disable
TEST_DATABASE_URL=postgres://postgres@localhost:5432/go_course_tasks_test?sslmode=disable

# Structured application logs; credentials and payloads are excluded.
LOG_LEVEL=INFO
LOG_FORMAT=text
